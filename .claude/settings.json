{
  "permissions": {
    "allow": [
      "Agent(web-researcher)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/hooks/strictly-enforced-rules.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-harness-nav.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-improve-harness.sh"
          }
        ]
      }
    ]
  }
}
